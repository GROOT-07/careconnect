# Database - SQLite for local, replace with PostgreSQL for production
DATABASE_URL="file:./dev.db"

# Auth - generate with: openssl rand -base64 32
NEXTAUTH_SECRET="your-secret-here-generate-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"

# Anthropic API - get from console.anthropic.com
ANTHROPIC_API_KEY="sk-ant-your-key-here"

# For production (Vercel), replace DATABASE_URL with:
# DATABASE_URL="postgresql://user:password@host:5432/careconnect"
